# Copie para .env e ajuste. Nunca versione o arquivo .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Persistência (em produção, aponte para um volume/disco persistente)
DATABASE_PATH=data/calibra.db
UPLOAD_DIR=data/uploads

# Fuso usado para calcular "hoje" nos lembretes
TIMEZONE=America/Sao_Paulo

# Uploads
MAX_UPLOAD_MB=10
USER_STORAGE_MB=200

# Segurança
# Em produção atrás de HTTPS: COOKIE_SECURE=true (padrão quando NODE_ENV=production)
COOKIE_SECURE=false
# true somente se estiver atrás de proxy reverso confiável (Render, Fly, Nginx...)
TRUST_PROXY=false
SESSION_DAYS=30
ALLOW_REGISTRATION=true

# Aviso de manutenção por km: avisa quando faltar este número de km
MAINTENANCE_KM_WINDOW=500
